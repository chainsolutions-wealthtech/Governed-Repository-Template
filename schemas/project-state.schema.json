{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Governed Project State",
  "type": "object",
  "required": [
    "repository",
    "canonical_branch",
    "state",
    "baseline_head",
    "last_verified_at"
  ],
  "properties": {
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "canonical_branch": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string"
    },
    "baseline_head": {
      "type": "string"
    },
    "last_verified_at": {
      "type": "string"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
