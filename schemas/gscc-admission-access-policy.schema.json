{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chainsolutions.example/schemas/gscc-admission-access-policy.schema.json",
  "title": "GSCC Admission Access Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority_id",
    "default_decision",
    "read_only_requested_capabilities",
    "read_only_authority_class",
    "constraints",
    "operational_or_mutation_authority_policy",
    "invocation_authority_granted",
    "mutation_authority_granted"
  ],
  "properties": {
    "schema": {
      "const": "gscc-admission-access-policy/v1"
    },
    "authority_id": {
      "type": "string",
      "minLength": 1
    },
    "default_decision": {
      "const": "DENY"
    },
    "read_only_requested_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "read_only_authority_class": {
      "const": "READ_ONLY_DISCOVERY_AUTHORITY"
    },
    "constraints": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "boolean",
          "string",
          "number",
          "null"
        ]
      }
    },
    "operational_or_mutation_authority_policy": {
      "const": "EXPLICIT_SEPARATE_GOVERNANCE_EVIDENCE_REQUIRED"
    },
    "invocation_authority_granted": {
      "const": false
    },
    "mutation_authority_granted": {
      "const": false
    }
  }
}
