{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chainsolutions.example/schemas/gscc-admission-receipt.schema.json",
  "title": "GSCC Admission Receipt",
  "type": "object",
  "required": [
    "schema",
    "status",
    "repository_access",
    "invocation_authority_granted",
    "mutation_authority_granted",
    "provider_private_identity_inferred",
    "replay",
    "evaluated_at"
  ],
  "properties": {
    "schema": {
      "const": "gscc-admission-receipt/v1"
    },
    "status": {
      "enum": [
        "ADMISSION_INCOMPLETE",
        "ADMISSION_INVALID",
        "ADMISSION_DENIED",
        "ADMISSION_AMBIGUOUS",
        "PREAUTHORIZED"
      ]
    },
    "admission_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "connection_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "repository_access": {
      "const": "NOT_YET_GRANTED"
    },
    "invocation_authority_granted": {
      "const": false
    },
    "mutation_authority_granted": {
      "const": false
    },
    "provider_private_identity_inferred": {
      "const": false
    },
    "replay": {
      "type": "boolean"
    },
    "reason_code": {
      "type": "string"
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_surface": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_step": {
      "type": "string"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "envelope_digest": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
