    "TWO_STAGE_AGENT_PURPOSE_ROUTING_TARGET",
    "HUMAN_TECHNICAL_EXECUTION_NOT_REQUIRED",
    "AUTOMATION_MUST_NOT_BYPASS_AUTHORITY_OR_APPROVAL",
    "CLIENT_UPGRADE_VERSION_FROM_TEMPLATE_MANIFEST",
    "CLIENT_UPGRADE_PRESERVES_MUTABLE_PROJECT_STATE",
    "CLIENT_CI_SOURCE_ONLY_STEPS_SKIP_CLEANLY"
