{
  "schema_version": "1.2.0",
  "control_plane_repository": "chainsolutions-wealthtech/Governed-Repository-Template",
  "source_role": "CENTRAL_GOVERNANCE_CONTROL_PLANE",
  "client_role_after_instantiation": "GOVERNED_TARGET_CLIENT",
  "transport": {
    "primary": "GITHUB_ISSUE_CONVERSATION",
    "local_engine": "scripts/governed_request.py",
    "issue_bridge": "scripts/control_plane_issue_bridge.py"
  },
  "lifecycle": [
    "REQUEST_CREATED",
    "WAITING_FOR_ANSWER",
    "PLAN_READY",
    "WAITING_FOR_PLAN_APPROVAL",
    "EXECUTING_PREPARATION",
    "HOLD_FOR_REVIEW",
    "HANDOFF_READY",
    "CLOSED"
  ],
  "principles": [
    "CONTROL_PLANE_PREPARES_TARGET_WORK",
    "ONE_QUESTION_OR_ACTION_REQUEST_AT_A_TIME",
    "AGENT_RESPONSES_ADVANCE_STATE_MACHINE",
    "TARGET_MUTATION_REQUIRES_EXPLICIT_AUTHORITY",
    "TARGET_EVIDENCE_NE_ASSUMED_STATE",
    "CONTROL_PLANE_STATE_STAYS_OUT_OF_TEMPLATE_CONTENT",
    "HANDOFF_IS_EXPLICIT",
    "CROSS_REPOSITORY_MUTATION_ONLY_VIA_AUTHORIZED_EXECUTOR",
    "STANDARD_GITHUB_TOKEN_CANNOT_CREATE_TARGET_REPOSITORIES",
    "CREATOR_CREDENTIALS_STAY_OUTSIDE_GIT",
    "SOURCE_CONTROL_PLANE_MEMORY_NE_DISTRIBUTED_PROJECT_STATE",
    "CONTROL_PLANE_MEMORY_FRESHNESS_REQUIRED",
    "SOURCE_ONLY_MEMORY_REMOVED_FROM_CLIENTS",
    "CASE_REPLAY_LEDGER_REQUIRED_FOR_ACTIVE_MACRO_CASE",
    "OWNER_FEEDBACK_MUST_BE_RECONCILED_BEFORE_CONTINUATION",
    "CANONICAL_MEMORY_HAS_QUERYABLE_RELATIONAL_PROJECTION",
    "DATABASE_EVOLVES_BY_VERSIONED_MIGRATIONS"
  ],
  "source_only_paths": [
    ".github/workflows/governed-control-plane.yml",
    ".github/ISSUE_TEMPLATE/governed-request.yml",
    "docs/control-plane",
    ".governance/control-plane-state",
    ".governance/control-plane-db"
  ],
  "current_role": "CENTRAL_GOVERNANCE_CONTROL_PLANE",
  "executor": {
    "repository_creation": "scripts/control_plane_create_repository.py",
    "authority_policy": ".governance/repository-creation-executor.json",
    "github_endpoint": "POST /repos/chainsolutions-wealthtech/Governed-Repository-Template/generate"
  },
  "source_memory": {
    "human_authorities": [
      "docs/control-plane/CURRENT_STATE.md",
      "docs/control-plane/SUIVI.md",
      "docs/control-plane/NEXT_ACTION.md",
      "docs/control-plane/DECISIONS_LOG.md",
      "docs/control-plane/TASKS.md",
      "docs/control-plane/PROGRAM.md",
      "docs/control-plane/CASE1_REPLAY_LEDGER.md"
    ],
    "machine_authorities": [
      ".governance/control-plane-state/current.json",
      ".governance/control-plane-state/checkpoint.json",
      ".governance/control-plane-state/handoff.json",
      ".governance/control-plane-state/tasks.json",
      ".governance/control-plane-state/case1-replay.json"
    ],
    "issue_role": "ORCHESTRATION_AND_EVIDENCE_NOT_CANONICAL_SOURCE",
    "conversation_role": "SUPPLEMENTAL_CONTEXT_ONLY"
  },
  "canonical_memory_database": {
    "role": "QUERYABLE_PROJECTION_OF_VERSIONED_CANONICAL_MEMORY",
    "source_of_truth": "VERSIONED_SQL_JSON_AND_CONTROL_PLANE_AUTHORITIES",
    "runtime_database": "MATERIALIZED_NOT_COMMITTED_BINARY",
    "current_engine": "SQLITE_VALIDATION_PROJECTION",
    "target_engine": "POSTGRESQL_COMPATIBLE_APPLICATION_DATABASE",
    "frontend_future": true,
    "source_paths": [
      ".governance/control-plane-db/001_schema.sql",
      ".governance/control-plane-db/catalog.json",
      ".governance/control-plane-db/runtime-seed.json",
      ".governance/control-plane-db/materialize.py"
    ],
    "invariants": [
      "DATABASE_BINARY_NOT_CANONICAL_IN_GIT",
      "SCHEMA_AND_SEEDS_AUDITABLE_IN_GIT",
      "ALL_STRUCTURING_CASES_SHARE_THE_SAME_RELATIONAL_MODEL",
      "OWNER_FEEDBACK_AND_DECISIONS_ARE_FIRST_CLASS_RECORDS",
      "CHECKPOINTS_AND_HANDOFFS_ARE_QUERYABLE",
      "CLIENT_REPOSITORIES_DO_NOT_RECEIVE_CONTROL_PLANE_DATABASE"
    ]
  }
}
