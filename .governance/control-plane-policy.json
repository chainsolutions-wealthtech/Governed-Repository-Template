    "TARGET_ARCHITECTURE_NE_LIVE_CURRENT_STATE",
    "CANONICAL_AUTHORITIES_REVISIONED_MONOTONICALLY",
    "APPEND_HISTORY_PLUS_CURRENT_PROJECTION",
