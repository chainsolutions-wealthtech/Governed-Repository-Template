    "NO_SECRET_VALUES_OR_PRIVATE_KEYS",
    "CAPABILITY_NE_AUTHORITY",
    "OPERATION_RECIPE_NE_EXECUTION_AUTHORITY",
    "ALL_MUTATIONS_REQUIRE_PREFLIGHT_VERIFY_AND_ROLLBACK",
    "EXISTING_SERVER_PATTERNS_ARE_REUSED_BEFORE_NEW_LAYOUT_IS_INVENTED"
