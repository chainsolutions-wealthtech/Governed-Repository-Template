  "github_operation_allowlist": {
    "GITHUB_CREATE_REPOSITORY_FROM_TEMPLATE": {
      "method": "POST",
      "endpoint_template": "/repos/{template_owner}/{template_repo}/generate",
      "required_parameters": [
        "template_owner",
        "template_repo",
        "target_owner",
        "name",
        "private"
      ],
      "verify": "GET_TARGET_REPOSITORY"
    },
    "GITHUB_CREATE_BRANCH": {
      "method": "POST",
      "endpoint_template": "/repos/{repository}/git/refs",
      "required_parameters": [
        "repository",
        "branch",
        "source_sha"
      ],
      "verify": "GET_BRANCH_REF"
    },
    "GITHUB_UPSERT_FILE": {
      "method": "PUT",
      "endpoint_template": "/repos/{repository}/contents/{path}",
      "required_parameters": [
        "repository",
        "path",
        "message",
        "content_b64",
        "branch"
      ],
      "verify": "GET_CONTENT"
    },
    "GITHUB_CREATE_PULL_REQUEST": {
      "method": "POST",
      "endpoint_template": "/repos/{repository}/pulls",
      "required_parameters": [
        "repository",
        "title",
        "head",
        "base"
      ],
      "verify": "GET_PULL_REQUEST"
    },
    "GITHUB_MERGE_PULL_REQUEST": {
      "method": "PUT",
      "endpoint_template": "/repos/{repository}/pulls/{pull_number}/merge",
      "required_parameters": [
        "repository",
        "pull_number",
        "expected_head_sha"
      ],
      "verify": "GET_PULL_REQUEST"
    },
    "GITHUB_CONFIGURE_BRANCH_PROTECTION": {
      "method": "PUT",
