  "canonical_authorities": [
    "CP-ARCH-001",
    "CP-GOVMODEL-001",
    "CP-GOVMODEL-001-R2",
    "CP-MCP-CAP-001",
    "CP-ADAPTIVE-QUESTIONS-001",
    "CP-KNOWLEDGE-001",
    "CP-SERVER-KNOWLEDGE-001",
    "CP-IDENTITY-SECRET-001",
    "CP-EXECUTION-001",
    "CP-NAMESPACE-001",
    "CP-CAPSULE-001",
    "CP-AGENT-RELAY-001",
    "CP-AGENT-RELAY-001-R2",
    "CP-AGENT-RELAY-001-R3",
    "CP-AGENT-RELAY-001-R4",
    "CP-AGENT-RELAY-001-R5"
  ],
  "definition_sources": [
    {
      "kind": "CPD",
      "path": "docs/control-plane/DECISIONS_LOG.md",
      "extractor": "MARKDOWN_H3_DECISION_HEADINGS"
    },
    {
      "kind": "TASK",
      "path": ".governance/control-plane-state/tasks.json",
      "extractor": "ITEM_IDS"
    },
    {
      "kind": "AQ_AQI",
      "path": ".governance/control-plane-state/adaptive-question-catalogue.json",
      "extractor": "QUESTIONS_AND_IMPLEMENTATION_IDS"
    },
    {
      "kind": "KBI_CORE",
      "path": ".governance/control-plane-state/knowledge-base.json",
      "extractor": "FUTURE_INCREMENTAL_WORK_IDS"
    },
    {
      "kind": "KBI_SERVER_SRV_OP",
      "path": ".governance/control-plane-state/server-knowledge-model.json",
      "extractor": "INCREMENTAL_SLICE_AND_RECIPE_IDS"
    },
    {
      "kind": "KBI_IDSEC",
      "path": ".governance/control-plane-state/identity-secret-lifecycle.json",
      "extractor": "INCREMENTAL_SLICE_AND_OPERATION_IDS"
    },
    {
      "kind": "GMC",
      "path": ".governance/control-plane-state/governance-model-execution-blueprint.json",
      "extractor": "GROUP_TASK_ARTIFACT_EVIDENCE_EXIT_IDS"
    },
    {
      "kind": "CONTINUITY",
      "path": ".governance/control-plane-state/checkpoint.json",
      "extractor": "CHECKPOINT_ID"
    },
    {
      "kind": "CONTINUITY",
      "path": ".governance/control-plane-state/handoff.json",
      "extractor": "HANDOFF_ID"
    }
  ],
  "new_definition_contract": {
    "required_before_runtime_binding": [
      "id",
      "kind",
      "parent_or_program",
      "integration_slot",
      "status",
      "canonical_source",
      "dependencies",
      "collision_domain"
    ],
    "legacy_backfill_policy": "DO_NOT_BLOCK_EXISTING_LEGACY_ITEMS_ONLY_FOR_MISSING_LINEAGE_FIELDS; FAIL_NEW_ID_COLLISIONS_AND_UNREGISTERED_NAMESPACES_IMMEDIATELY",
    "additive_rule": "APPEND_OR_SUPERSEDE_EXISTING_LINEAGE_NEVER_PARALLEL_UNSCOPED_LIST"
  },
  "multi_agent_collision_contract": {
    "semantic_identity_key": "namespace + canonical id",
    "collision_domains": [
      "CANONICAL_NAMESPACE_REGISTRY",
      "CANONICAL_DECISION_LOG",
      "PROGRAM_TASK_GRAPH",
      "GOVERNANCE_MODEL_BLUEPRINT",
      "CURRENT_MACHINE_PROJECTION",
      "TARGET_REPOSITORY_MUTATION"
    ],
    "required_guards": [
      "registered namespace",
      "unique canonical definition id",
      "parent/integration-slot resolution before runtime binding",
      "dependency-safe dispatch",
      "claim before mutable work",
      "single writer per collision domain",
      "exact-head precondition",
      "reconcile on HEAD_MOVED",
      "structured checkpoint and handoff",
      "heartbeat lease for active agents",
      "stalled claim preserved until reconciled takeover"
    ],
    "id_collision_behavior": "FAIL_CI_AND_HOLD_FOR_REVIEW",
    "concurrent_write_behavior": "CLAIM_OR_HEAD_COLLISION_FAILS_CLOSED",
    "note": "This registry prevents namespace/semantic identity collisions. Existing session/claim/exact-head mechanisms remain necessary to prevent concurrent write collisions."
  },
  "legacy_reconciliation": [
    {
      "old_id": "CPD-041",
      "canonicalized_id": "CPD-047",
      "subject": "Domain planning is a server-scoped choice chain",
      "reason": "ACCIDENTAL_DUPLICATE_DECISION_ID",
      "preservation": "CONTENT_PRESERVED; ONLY_CANONICAL_IDENTIFIER_DISAMBIGUATED"
    }
  ],
  "integration_slots": [
    {
      "id": "ARCH-006",
      "purpose": "cross-authority CI consistency checks"
    },
    {
      "id": "GMC-G02",
      "purpose": "metamodel and stable identifier contracts"
    },
    {
      "id": "GMC-G13",
      "purpose": "global dependency graph and lineage validation"
    },
    {
      "id": "IDN-006",
      "purpose": "session continuity and ownership context"
    },
    {
      "id": "RTE-006",
      "purpose": "existing-task versus new-intake resolution"
    }
  ]
}
