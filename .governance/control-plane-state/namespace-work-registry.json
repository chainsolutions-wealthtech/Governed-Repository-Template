{
  "schema_version": "1.0.0",
  "authority_id": "CP-NAMESPACE-001",
  "status": "CANONICAL_NAMESPACE_AND_WORK_ID_RULES",
  "scope": "CONTROL_PLANE_SOURCE_ONLY",
  "purpose": "PREVENT_ID_NAMESPACE_LINEAGE_AND_MULTI_AGENT_SEMANTIC_COLLISIONS_WITHOUT_DUPLICATING_CANONICAL_WORK_SOURCES",
  "source_of_truth_model": "NAMESPACE_RULES_PLUS_DERIVED_INDEX_FROM_CANONICAL_AUTHORITIES",
  "principles": [
    "DO_NOT_DUPLICATE_CANONICAL_TASK_LISTS",
    "EVERY_NEW_CANONICAL_ID_MUST_MATCH_ONE_REGISTERED_NAMESPACE",
    "CANONICAL_DEFINITION_IDS_ARE_UNIQUE_WITHIN_THEIR_TYPE",
    "NEW_WORK_EXTENDS_EXISTING_LINEAGE",
    "NEW_WORK_MUST_DECLARE_PARENT_OR_INTEGRATION_SLOT_BEFORE_EXECUTION_BINDING",
    "HISTORY_IS_APPEND_OR_SUPERSEDE_NEVER_SILENT_OVERWRITE",
    "MULTI_AGENT_WRITERS_SHARE_CANONICAL_NAMESPACE_RULES",
    "SINGLE_WRITER_PER_COLLISION_DOMAIN",
    "EXACT_HEAD_RECONCILIATION_BEFORE_MUTATION",
    "CLAIMS_AND_DEPENDENCY_SAFE_DISPATCH_REMAIN_REQUIRED_FOR_CONCURRENT_EXECUTION"
  ],
  "namespaces": [
    {
      "id": "CP-CHECKPOINT",
      "pattern": "^CP-CHECKPOINT-\\d{8}-\\d{3}$",
      "kind": "CONTINUITY_CHECKPOINT",
      "canonical_source": ".governance/control-plane-state/checkpoint.json"
    },
    {
      "id": "CP-HANDOFF",
      "pattern": "^CP-HANDOFF-\\d{8}-\\d{3}$",
      "kind": "CONTINUITY_HANDOFF",
      "canonical_source": ".governance/control-plane-state/handoff.json"
    },
    {
      "id": "CP",
      "pattern": "^CP-(?!CHECKPOINT-|HANDOFF-)[A-Z][A-Z0-9-]*-\\d{3}(?:-R\\d+)?$",
      "kind": "CANONICAL_AUTHORITY",
      "canonical_source": "authority-owning source files"
    },
    {
      "id": "CPD",
      "pattern": "^CPD-\\d{3}$",
      "kind": "CANONICAL_DECISION",
      "canonical_source": "docs/control-plane/DECISIONS_LOG.md"
    },
    {
      "id": "SG-PACKAGE",
      "pattern": "^SG-\\d{8}-\\d{3}$",
      "kind": "HISTORICAL_WORK_PACKAGE",
      "canonical_source": "program/history authorities"
    },
    {
      "id": "SG",
      "pattern": "^SG-\\d{3}$",
      "kind": "SELF_GOVERNED_TASK",
      "canonical_source": "task/program authorities"
    },
    {
      "id": "P12",
      "pattern": "^P12-S\\d+$",
      "kind": "PROGRAM_PHASE",
      "canonical_source": ".governance/control-plane-state/tasks.json"
    },
    {
      "id": "C1",
      "pattern": "^C1-\\d{2}(?:-[A-Z])+$",
      "kind": "CASE1_TASK_OR_SUBTASK",
      "canonical_source": ".governance/control-plane-state/tasks.json"
    },
    {
      "id": "ARCH",
      "pattern": "^ARCH-\\d{3}$",
      "kind": "ARCHITECTURE_BACKLOG",
      "canonical_source": ".governance/control-plane-state/tasks.json"
    },
    {
      "id": "IDN",
      "pattern": "^IDN-\\d{3}$",
      "kind": "IDENTITY_SESSION_BACKLOG",
      "canonical_source": ".governance/control-plane-state/tasks.json"
    },
    {
      "id": "RTE",
      "pattern": "^RTE-\\d{3}$",
      "kind": "ROUTING_BACKLOG",
      "canonical_source": ".governance/control-plane-state/tasks.json"
    },
    {
      "id": "CAP",
      "pattern": "^CAP-\\d{3}$",
      "kind": "REUSABLE_CAPSULE_PRODUCTIZATION_BACKLOG",
      "canonical_source": ".governance/control-plane-state/tasks.json"
    },
    {
      "id": "AQ",
      "pattern": "^AQ-\\d{3}[A-Z]?$",
