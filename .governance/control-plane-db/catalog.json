      "mutation_class": "ADDITIVE_WRITE",
      "required_authority": "ADOPTION_PLAN_ACCEPTED",
      "required_evidence": [
        "no_overwrite",
        "validation_pass"
      ]
    },
    {
      "activity_id": "C3-A-MAP",
      "case_id": "MAP_EXISTING_PROJECT",
