{
  "schema_version": "1.5.0",
  "role": "REPOSITORY_TO_MCP_BINDING",
  "preferred_transport": "DIRECT_MCP_TOKEN",
  "fallback_transport": "GITHUB_OIDC_EPHEMERAL_SSH_CERTIFICATE",
  "direct_mcp": {
    "endpoint_variable": "GOVERNED_MCP_URL",
    "token_secret": "GOVERNED_MCP_AUTH_TOKEN",
    "default_endpoint": null,
    "discovery_tools": [
      "ping",
      "get_project_context",
      "list_domains_s1",
      "list_domains_s2",
      "get_write_tools_context"
    ],
    "credential_provisioning": {
      "mode": "CENTRAL_CONTROL_PLANE_REPOSITORY_SECRET",
      "source_secret": "GOVERNED_MCP_AUTH_TOKEN",
      "target_secret": "GOVERNED_MCP_AUTH_TOKEN",
      "transport": "GITHUB_APP_INSTALLATION_TOKEN",
      "required_target_permission": "repository:Secrets:write",
      "source_value_exposure": "FORBIDDEN",
      "trigger": "ANY_GOVERNED_LOCAL_COMMAND_WHEN_DIRECT_CREDENTIAL_APPLIES",
      "attestation": "TARGET_SECRET_METADATA_ONLY",
      "fallback": "BOTH_MAY_DEGRADE_TO_GITHUB_OIDC_EPHEMERAL_SSH_READONLY",
      "mandatory_for": [
        "DIRECT_MCP_TOKEN"
      ],
      "optional_for": [
        "BOTH"
      ],
      "opportunistic_for": [
        "BOTH"
      ]
    }
  },
  "ssh": {
    "mode": "GITHUB_OIDC_EPHEMERAL_CERTIFICATE",
    "broker_path": "/access/github/repository-ssh/certificate",
    "oidc_audience": "https://mcp.wealthtechinnovations.com/access/github/repository-ssh",
    "workflow": ".github/workflows/governed-local-entry.yml",
    "key_algorithm": "ed25519",
    "key_lifetime": "RUNNER_EPHEMERAL_ONLY",
    "certificate_max_seconds": 600,
    "host_profile_source": "OWNER_ANSWER_CROSS_CHECKED_WITH_SIGNED_BROKER_RESPONSE",
    "known_hosts_source": "AUTHENTICATED_BROKER_RESPONSE",
    "strict_host_key_checking": "REQUIRED",
    "arbitrary_shell": "FORBIDDEN",
    "persistent_private_key_secret": "FORBIDDEN",
    "allowed_commands": [
      "ping",
      "project-context",
      "list-domains-s1",
      "list-domains-s2",
      "docker-status-s1",
      "docker-status-s2",
      "write-tools-context"
    ],
    "write_authority": "MCP_SCOPED_WRITE_ONLY",
    "both_semantics": {
      "preferred": "DIRECT_MCP_PLUS_SSH_EVIDENCE",
      "degraded_without_direct_credential": "SSH_OIDC_READONLY_DISCOVERY",
      "degraded_status": "PARTIAL",
      "write_authority": "UNCHANGED_MCP_SCOPED_WRITE_ONLY"
    }
  },
  "invariants": [
    "NO_SECRET_IN_GIT",
    "NO_PERSISTENT_REPOSITORY_SSH_PRIVATE_KEY",
    "READ_ONLY_DISCOVERY_FIRST",
    "WRITE_TOOLS_REQUIRE_PROJECT_REGISTRATION",
    "DOMAIN_CREATION_REQUIRES_EXPLICIT_APPROVAL",
    "MCP_STATE_NE_GITHUB_STATE",
    "CONTROL_PLANE_MCP_SECRET_PROVISIONING_NEVER_EXPOSES_SECRET_VALUE",
    "TARGET_MCP_SECRET_IS_PROVISIONED_ONLY_AT_EXACT_HEAD_CREDENTIAL_GATE",
    "BOTH_DIRECT_CREDENTIAL_ABSENCE_MUST_NOT_BLOCK_READ_ONLY_SSH_DISCOVERY",
    "BOTH_SSH_ONLY_EVIDENCE_MUST_BE_RECORDED_AS_PARTIAL_DEGRADED",
    "MCP_DISCOVERY_FAILURES_ON_EXACT_HEAD_ARE_PERSISTED_RETRYABLE",
    "HEAD_MOVED_NEVER_PERSISTS_AS_DISCOVERY_EVIDENCE",
    "BOTH_USES_CENTRAL_DIRECT_CREDENTIAL_WHEN_AVAILABLE"
  ],
  "discovery_failure_policy": {
    "persist_exact_head_failures": true,
    "retry_command": "/local-execute",
    "retry_state": "MCP_DISCOVERY",
    "head_moved_mutates_state": false,
    "failure_evidence_secrecy": "NON_SECRET_CODES_ONLY"
  }
}
