{
  "schema_version": "1.0.0",
  "process_name": "GACR",
  "process_title": "Governed Agent Continuity Relay",
  "authority_id": "CP-AGENT-RELAY-001",
  "enabled": true,
  "heartbeat_interval_seconds": 300,
  "suspected_stall_after_seconds": 900,
  "stalled_after_seconds": 1800,
  "supervisor_scan_interval_minutes": 10,
  "external_conversation_reference": {
    "allowed": true,
    "persist_full_url": false,
    "persist_provider_reference": true,
    "reconstruct_known_provider_url_when_requested": true,
    "automatic_browser_url_capture": false,
    "note": "A provider URL/reference is recorded only when explicitly supplied by the client/orchestrator. The model must never invent a conversation identifier."
  },
  "takeover": {
    "auto_detect_stall": true,
    "auto_offer_to_compatible_standby": true,
    "auto_execute_takeover": false,
    "requires_exact_head_reconciliation": true,
    "transfers_active_claims_only_after_accept": true,
    "stale_predecessor_cannot_resume_after_transfer": true
  },
  "states": [
    "ACTIVE",
    "STANDBY",
    "SUSPECTED_STALL",
    "STALLED",
    "TAKEOVER_READY",
    "HANDOFF_STALLED",
    "CLOSED"
  ],
  "reusable_across_projects": true,
  "execution_authority_granted": false,
  "telemetry": {
    "beacon_enabled": true,
    "correlation_enabled": true,
    "dispatcher_enabled": true,
    "safe_github_context_only": true,
    "raw_event_payload_persisted": false,
    "secret_values_persisted": false,
    "correlation_levels": [
      "EXACT",
      "STRONG",
      "PROBABLE",
      "AMBIGUOUS",
      "UNKNOWN"
    ],
    "auto_bind_levels": [
      "EXACT",
      "STRONG"
    ],
    "default_wake_channel": "POLL_REPOSITORY"
  },
  "external_bridge": {
    "contract_only": true,
    "can_capture_conversation_ref_when_client_supplies_it": true,
    "can_capture_client_instance_id": true,
    "can_receive_dispatch_offer": true,
    "outbound_browser_wakeup_implemented": false,
    "note": "Repository-side GACR can prepare and target wake events. A provider/client bridge is still required to wake a browser conversation."
  }
}
