{
  "schema_version": "1.6.0",
  "process_name": "GACR",
  "process_title": "Governed Agent Continuity Relay",
  "authority_id": "CP-AGENT-RELAY-001",
  "enabled": true,
  "heartbeat_interval_seconds": 300,
  "suspected_stall_after_seconds": 900,
  "stalled_after_seconds": 1800,
  "supervisor_scan_interval_minutes": 10,
  "external_conversation_reference": {
    "allowed": true,
    "persist_full_url": false,
    "persist_provider_reference": true,
    "reconstruct_known_provider_url_when_requested": true,
    "automatic_browser_url_capture": false,
    "note": "A provider URL/reference is recorded only when explicitly supplied by the client/orchestrator. The model must never invent a conversation identifier."
  },
  "takeover": {
    "auto_detect_stall": true,
    "auto_offer_to_compatible_standby": true,
    "auto_execute_takeover": false,
    "requires_exact_head_reconciliation": true,
    "transfers_active_claims_only_after_accept": true,
    "stale_predecessor_cannot_resume_after_transfer": true
  },
  "states": [
    "ACTIVE",
    "STANDBY",
    "SUSPECTED_STALL",
    "STALLED",
    "TAKEOVER_READY",
    "HANDOFF_STALLED",
    "CLOSED"
  ],
  "reusable_across_projects": true,
  "execution_authority_granted": false,
  "telemetry": {
    "beacon_enabled": true,
    "correlation_enabled": true,
    "dispatcher_enabled": true,
    "safe_github_context_only": true,
    "raw_event_payload_persisted": false,
    "secret_values_persisted": false,
    "correlation_levels": [
      "EXACT",
      "STRONG",
      "PROBABLE",
      "AMBIGUOUS",
      "UNKNOWN"
    ],
    "auto_bind_levels": [
      "EXACT",
      "STRONG"
    ],
    "default_wake_channel": "POLL_REPOSITORY",
    "forensics_enabled": true,
    "action_trace_fields": [
      "action_id",
      "action_label",
      "action_phase",
      "tool_name",
      "tool_call_id",
      "outcome",
      "written_head_sha",
      "checkpoint_ref",
      "evidence_ref",
      "interruption_code"
    ]
  },
  "external_bridge": {
    "contract_only": false,
    "can_capture_conversation_ref_when_client_supplies_it": true,
    "can_capture_client_instance_id": true,
    "can_receive_dispatch_offer": true,
    "outbound_browser_wakeup_implemented": false,
    "note": "Repository-side GACR can prepare and target wake events. R6 adds a GitHub issue-comment ingress for provider hosts that cannot call repository_dispatch directly; provider browser wake remains a separate capability.",
    "client_emitter_implemented": true,
    "client_emitter_wake_polling": true,
    "chatgpt_issue_bridge_implemented": true,
    "chatgpt_issue_bridge_live_proven": true,
    "provider_host_live_mode": "EVENT_DRIVEN_GITHUB_ISSUE_COMMENT",
    "continuous_background_heartbeat_proven": false
  },
  "revision_authority_id": "CP-AGENT-RELAY-001-R6",
  "forensics": {
    "enabled": true,
    "projection_only": true,
    "derives_from": [
      "sessions",
      "claims",
      "takeovers",
      "beacons",
      "correlations",
      "dispatches"
    ],
    "external_cause_policy": "OBSERVED_ONLY_NEVER_INFER",
    "exact_head_reobservation_before_resume": true,
    "in_flight_action_replay": "FORBIDDEN_WITHOUT_RECONCILIATION",
    "independent_lock_store": false,
    "lock_model": "CLAIMS_PLUS_COLLISION_DOMAINS"
  },
  "auto_attachment": {
    "enabled": true,
    "required_for_governed_arrival": true,
    "provider_conversation_ref_required": false,
    "source_priority": [
      "EXPLICIT_CLIENT",
      "FRESH_CONVERSATION_CHRONICLE",
      "GITHUB_ACTIONS"
    ],
    "chronicle_freshness_seconds": 3600,
    "late_provider_binding_reuses_connection_session": true,
    "duplicate_session_on_late_provider_binding": false,
    "unobservable_provider_reference_state": "UNAVAILABLE",
    "main_push_auto_attach": true,
    "github_actions_bot_state_push_reentry": false,
    "note": "A governed arrival attaches with the strongest observable anchor. Missing provider conversation metadata never blocks attachment and may enrich the same session later.",
    "internal_transport_workflows": [
      "Governed Agent Continuity Relay"
    ],
    "internal_transport_identity_policy": "NEVER_CREATE_SESSION",
    "unobservable_internal_transport_behavior": "SKIP_AND_REFRESH_DERIVED_CORRELATIONS",
    "stale_chronicle_behavior": "DO_NOT_PROMOTE_INTERNAL_GACR_TRANSPORT_TO_AGENT"
  },
  "client_emitter": {
    "enabled": true,
    "provenance": "CLIENT_EMITTER",
    "transport": "GITHUB_REPOSITORY_DISPATCH",
    "heartbeat_interval_seconds": 300,
    "supports": [
      "AUTO_ATTACH",
      "HEARTBEAT",
      "ACTION_TRACE",
      "INTERRUPTION_SIGNAL",
      "WAKE_POLL"
    ],
    "runtime_credential_policy": "MEMORY_ONLY_NEVER_PERSIST",
    "repository_dispatch_events": [
      "gacr_auto-attach",
      "gacr_heartbeat",
      "gacr_beacon"
    ],
    "interruption_signal_policy": "EXPLICIT_OBSERVATION_ONLY",
    "wake_poll_may_accept_takeover": false,
    "takeover_requires_exact_head_reconciliation": true,
    "note": "Provider/host adapters may use the client emitter SDK/CLI. The emitter transports safe metadata only and never grants mutation authority."
  },
  "host_issue_bridge": {
    "enabled": true,
    "authority_id": "CP-AGENT-RELAY-001-R6",
    "decision_id": "CPD-056",
    "transport": "GITHUB_ISSUE_COMMENT",
    "issue_number": 115,
    "issue_title": "[GACR Host Bridge] Provider event ingress",
