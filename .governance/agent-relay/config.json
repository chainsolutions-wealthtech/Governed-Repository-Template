    "allowed_author_associations": [
      "OWNER",
      "MEMBER",
      "COLLABORATOR"
    ],
    "max_payload_chars": 8192,
    "supported_events": [
      "attach",
      "heartbeat",
      "action",
      "interrupt"
    ],
    "auto_attach_before_event": true,
    "auto_resolve_session": true,
    "idempotency_key": "GITHUB_ISSUE_COMMENT_ID",
    "provenance": "CLIENT_EMITTER",
    "raw_transcript_persisted": false,
    "secret_values_persisted": false,
    "execution_authority_granted": false,
    "live_proof_status": "PASS_CHATGPT_EVENT_DRIVEN",
    "source_issue_number_distributed": false,
    "client_issue_strategy": "TITLE_FALLBACK_UNTIL_LOCAL_NUMBER_BOUND",
    "repository_local_issue_identity": true,
    "live_proof": {
