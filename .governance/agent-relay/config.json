    },
    "unbound_activity": {
      "storage_model": "CORRELATOR_PROJECTION_NO_SECOND_STORE",
      "statuses": [
        "UNBOUND",
        "RECONCILED",
        "SUPERSEDED"
      ],
      "ambiguous_or_unknown_auto_select": false,
      "renews_candidate_lease": false,
      "creates_candidate_progress": false,
      "reconciliation": "IDEMPOTENT_AUDITABLE"
